# Python
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
*.tmp
*.tmp.pptx

# Streamlit secrets - NEVER COMMIT THESE!
.streamlit/secrets.toml
secrets.toml

# Allow these .toml files (they're safe to commit)
!.streamlit/config.toml
!.streamlit/secrets.toml.example

# Presentations (large files)
*.pptx
*.ppt
docs/presentations/*.pptx
docs/presentations/*.ppt
!docs/presentations/*.example.pptx

# Environment variables
.env
.env.local

# Data files (if large)
# Uncomment if you don't want to track data files
# data/*.csv
# !data/sample_stock.csv

