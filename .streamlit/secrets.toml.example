# Snowflake Connection Secrets
# Copy this file to .streamlit/secrets.toml and fill in your credentials
# NEVER commit secrets.toml to Git!

# Format 1: Direct [snowflake] section (recommended for Streamlit Cloud)
[snowflake]
# Your Snowflake account identifier
# How to find it:
#   1. Log into Snowflake (app.snowflake.com)
#   2. Look at the URL: https://app.snowflake.com/[ACCOUNT_IDENTIFIER]/...
#   3. Or run in Snowsight: SELECT CURRENT_ACCOUNT();
# Examples:
#   - "xy12345" (simple format)
#   - "xy12345.us-east-1" (with region - most common)
#   - "xy12345.ap-southeast-1" (Asia Pacific region)
# Note: Include the region if your account uses it (most accounts do)
account = "your-account-identifier"

# Your Snowflake username
user = "your-username"

# Your Snowflake password
password = "your-password"

# Warehouse name (default: COMPUTE_WH)
warehouse = "your-warehouse-name"

# Database name
database = "your-database-name"

# Schema name (default: PUBLIC)
schema = "your-schema-name"

# Role name (default: ACCOUNTADMIN)
role = "your-role-name"

# Format 2: Alternative [connections.snowflake] format (also supported)
# Uncomment below if you prefer this format:
# [connections.snowflake]
# account = "your-account-identifier"
# user = "your-username"
# password = "your-password"
# warehouse = "your-warehouse-name"
# database = "your-database-name"
# schema = "your-schema-name"
# role = "your-role-name"
